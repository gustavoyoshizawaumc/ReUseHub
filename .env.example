# Banco de Dados - PostgreSQL
DB_HOST=localhost
DB_USER=seu_usuario_postgres
DB_PASSWORD=sua_senha_postgres

# Banco de Dados - MongoDB
MONGO_USER=seu_usuario_mongo
MONGO_PASSWORD=sua_senha_mongo
MONGO_URI=mongodb://seu_usuario_mongo:sua_senha_mongo@localhost:27017/reusehub?authSource=admin

# Autenticacao (JWT)
JWT_SECRET=gere_um_segredo_jwt_longo_e_seguro

# Front-End
VITE_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Resend (e-mail transacional)
RESEND_API_KEY=sua_chave_resend
RESEND_FROM_EMAIL=ReUseHub <noreply@reusehub.me>
